---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | CQLocalPal" description="That page doesn't exist — but your first night in Chongqing still can.">
  <section>
    <div class="container" style="text-align:center;">
      <p class="eyebrow">404</p>
      <h1>This alley doesn't exist.</h1>
      <p style="margin:0 auto 1.5rem;">Chongqing has 30,000 streets and this URL isn't one of them. Let's get you back to familiar ground.</p>
      <p>
        <a class="btn btn-primary" href="/en/">Back to the homepage</a>
        &nbsp;
        <a class="btn btn-secondary" href="/en/tours/">See the tours</a>
      </p>
    </div>
  </section>
</Base>

---
import Base from '../../../layouts/Base.astro';
import CTASection from '../../../components/CTASection.astro';
---
<Base title="Verified Reviews | CQ Buddy" description="Every review on CQ Buddy is tied to a completed, verifiable order — kept forever, good or bad. See how verification works while we welcome our first guests.">
  <section>
    <div class="container">
      <p class="eyebrow">Reviews</p>
      <h1>Verified, or it doesn't count.</h1>
      <p style="font-size:1.2rem;max-width:48ch;">We're welcoming our first guests right now, so this page is honestly empty. When reviews land, each one will be tied to a real completed order — we will never buy a review, borrow a quote, or quietly delete the bad ones.</p>
    </div>
  </section>

  <section class="white">
    <div class="container">
      <p class="eyebrow">How verification works</p>
      <h2>Three rules, kept forever.</h2>
      <div class="steps">
        <div class="step"><h3>Tied to an order</h3><p>Every review links to a booking that actually happened — date, service and party size on record.</p></div>
        <div class="step"><h3>Nothing deleted</h3><p>Good or bad, reviews stay. If we mess up, the fix is a reply and a refund, not a deletion.</p></div>
        <div class="step"><h3>Incentives disclosed</h3><p>If we ever discount something for a referral, the review still stands with that fact attached. No fake praise, ever.</p></div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <p class="eyebrow">Been with us?</p>
      <h2>Leave a review after your trip.</h2>
      <p>After your service you'll get one short message with a review link. Two minutes, honest words, and you help the next traveller decide.</p>
    </div>
  </section>

  <CTASection heading="Be one of the first to review us." />
</Base>

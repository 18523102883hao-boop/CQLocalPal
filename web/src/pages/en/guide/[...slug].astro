---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({
    params: { slug: g.id.replace(/^en\//, '') },
    props: { guide: g },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
---
<Base title={`${guide.data.title} | CQ Buddy Guide`} description={guide.data.description}>
  <section>
    <div class="container" style="max-width:760px;">
      <p class="eyebrow">Guide · verified {guide.data.date.toISOString().slice(0, 10)} by {guide.data.verifiedBy}</p>
      <h1>{guide.data.title}</h1>
      <article class="prose">
        <Content />
      </article>
      <hr style="border:none;border-top:1px solid var(--sand);margin:2.5rem 0 1.5rem;" />
      <p><strong>Prefer a human?</strong> Our ¥199 <a href="/en/tours/concierge/">Local Concierge</a> answers these questions for your exact trip on WhatsApp — or let us handle your <a href="/en/tours/first-night-chongqing/">first night</a> in person.</p>
    </div>
  </section>
</Base>

---
import Base from '../../../layouts/Base.astro';
import TrustBar from '../../../components/TrustBar.astro';
import Price from '../../../components/Price.astro';
import CTASection from '../../../components/CTASection.astro';
import { site } from '../../../config';

const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hi CQLocalPal! I want the Local Concierge (¥199/order). I arrive around: ')}`;
---
<Base title="Local Concierge — Remote Support ¥199/order | CQLocalPal" description="A real Chongqing local on WhatsApp for your whole trip window: SIM & payments, transport, translation, restaurant bookings, re-planning when things change. ¥199 per order, up to 4 travellers.">
  <section>
    <div class="container">
      <p class="eyebrow">Remote · 24-hour service window · 1–4 travellers</p>
      <h1>Local Concierge</h1>
      <p style="font-size:1.2rem;max-width:46ch;">A local on your WhatsApp before you fly, while you travel, and after you land. Ask anything — a photo of a menu, a train you can't decode, a plan that just fell apart. We fix it.</p>
      <p><Price cny={199} unit="per order · up to 4 travellers" id="price" /></p>
      <p>
        <a class="btn btn-primary" href="/en/booking/?product=concierge">Start with ¥199</a>
        &nbsp;
        <a class="btn btn-secondary" href={wa} rel="noopener">Try us on WhatsApp first</a>
      </p>
      <p class="muted small">{site.responsePromise}, {site.supportHours}.</p>
    </div>
  </section>

  <section class="white" style="padding-top:1rem;">
    <div class="container"><TrustBar /></div>
  </section>

  <section>
    <div class="container">
      <p class="eyebrow">What your ¥199 covers</p>
      <h2>One local, on call, for your window.</h2>
      <div class="grid">
        <div class="card"><h3>Before you fly</h3><p>Visa and arrival-card questions, eSIM advice, app list to install at home, realistic answers about weather, luggage and what to pack.</p></div>
        <div class="card"><h3>Getting set up</h3><p>Step-by-step help with payment apps, ride-hailing and maps. Screenshots welcome — we walk you through each screen.</p></div>
        <div class="card"><h3>On-the-spot translation</h3><p>Photograph a menu, a sign, a pharmacy label — send it, we translate and tell you what to say back.</p></div>
        <div class="card"><h3>Bookings &amp; changes</h3><p>Restaurant tables, train tickets guidance, and fast re-planning when rain, delays or closed sights wreck your day.</p></div>
        <div class="card"><h3>Local judgement</h3><p>"Is this normal?" "Is this price fair?" "Is this taxi legit?" Straight answers from someone who lives here.</p></div>
        <div class="card"><h3>Escalation help</h3><p>Lost passport, hotel dispute, medical visit? We help you communicate with the police, hotel or hospital in Chinese — by phone if needed.</p></div>
      </div>
    </div>
  </section>

  <section class="white">
    <div class="container">
      <p class="eyebrow">How it works</p>
      <h2>Three steps, then ask us anything.</h2>
      <div class="steps">
        <div class="step"><h3>Tell us your dates</h3><p>One message on WhatsApp or the booking form. We confirm the plan and your service window.</p></div>
        <div class="step"><h3>Pay ¥199</h3><p>Currently settled via WhatsApp (online payment coming once approved). Per order, not per person — your whole travel party shares one concierge.</p></div>
        <div class="step"><h3>Chat for 24 hours</h3><p>Start the window any time — the day before you fly, landing day, or mid-trip. Unused hours don't roll over.</p></div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <p class="eyebrow">Honest boundaries</p>
      <h2>What concierge is — and isn't.</h2>
      <p>We are not an emergency service. For police, fire or ambulance in China call <strong>110 / 119 / 120</strong> first — then message us and we'll help you communicate. We reply within 30 minutes during support hours ({site.supportHours}); outside those hours we answer as soon as we're back online.</p>
      <p>Travelling longer than 24 hours? Add extra windows at ¥99 each, or consider a <a href="/en/tours/first-night-chongqing/">First Night</a> or <a href="/en/tours/private/">Private Day</a> where a local is physically with you.</p>
    </div>
  </section>

  <section class="white">
    <div class="container">
      <p class="eyebrow">Good to know</p>
      <h2>Questions we hear a lot.</h2>
      <details><summary>Do you really answer within 30 minutes?</summary><p>Yes — during {site.supportHours}. That's written into our service promise, and if we ever miss it badly, your window extends for free.</p></details>
      <details><summary>Is it one chat for all four of us?</summary><p>Yes. One order, one group chat, your whole travel party. Only one phone needs to message us.</p></details>
      <details><summary>Can you book things for me, like train tickets?</summary><p>We guide you through the official apps (they require your passport) and can reserve restaurants or call venues for you in Chinese. We never add a markup on bookings.</p></details>
      <details><summary>What languages do you speak?</summary><p>English today; Bahasa Indonesia/Melayu, 한국어 and 日本語 support are rolling out with our local host team. Message us and we'll tell you what's live.</p></details>
      <details><summary>What if my plans change mid-window?</summary><p>That's exactly what we're for. Missed train, sudden rain, closed attraction — message us and we'll rebuild the plan with you.</p></details>
      <details><summary>Refund policy?</summary><p>Not used the window yet and your trip is cancelled? Full refund if you message us before the window starts. <a href="/en/legal/refunds/">Full policy →</a></p></details>
    </div>
  </section>

  <CTASection sku="Local Concierge" heading="One local on WhatsApp. That's the whole pitch." />
</Base>

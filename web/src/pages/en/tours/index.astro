---
import Base from '../../../layouts/Base.astro';
import ProductCard from '../../../components/ProductCard.astro';
import TrustBar from '../../../components/TrustBar.astro';
import CTASection from '../../../components/CTASection.astro';
import products from '../../../data/products.json';

const concierge = products['concierge'];
const others = ['first-night', 'private', 'first-night-family'].map((k) => products[k]);
const addon = products['non-spicy-food-tour'];
---
<Base title="Services in Chongqing | CQLocalPal" description="Remote local support from ¥200, first-night welcomes, private days with your own guide, family-paced arrivals and a non-spicy food walk. Proposed prices confirmed in writing — no payment before confirmation.">
  <section>
    <div class="container">
      <p class="eyebrow">Services</p>
      <h1>Chongqing, with someone local.</h1>
      <p style="font-size:1.2rem;max-width:46ch;">Remote support is open now. In-person experiences are in inquiry mode while we build the host bench — tell us your dates and we'll confirm team, transport and total in writing before any payment.</p>
    </div>
  </section>

  <section class="white" style="padding-top:1rem;">
    <div class="container"><TrustBar /></div>
  </section>

  <section>
    <div class="container">
      <div class="grid">
        <ProductCard hero href={`/en/tours/${concierge.slug}/`} name={concierge.name} priceCny={concierge.priceCny} unit={concierge.priceUnit} meta={`${concierge.duration} · Remote · Main service`} pitch={concierge.shortPitch} status={concierge.status} ctaLabel={concierge.ctaLabel} />
        {others.map((p) => (
          <ProductCard
            href={`/en/tours/${p.slug}/`}
            name={p.name}
            priceCny={p.priceCny}
            unit={p.priceUnit}
            meta={`${p.duration} · ${p.partySize}`}
            pitch={p.shortPitch}
            status={p.status}
            ctaLabel={p.ctaLabel}
          />
        ))}
        <ProductCard href={`/en/add-ons/${addon.slug}/`} name={addon.name} priceCny={addon.priceCny} unit={addon.priceUnit} meta={`${addon.duration} · ${addon.partySize}`} pitch={addon.shortPitch} status={addon.status} ctaLabel={addon.ctaLabel} />
      </div>
    </div>
  </section>

  <section class="white">
    <div class="container">
      <p class="eyebrow">How booking works</p>
      <h2>Request first. Payment last.</h2>
      <div class="steps">
        <div class="step"><h3>Send your dates</h3><p>The booking form or WhatsApp. For remote support we check the 72-hour window capacity; for experiences we check the team.</p></div>
        <div class="step"><h3>Written confirmation</h3><p>Scope, host or backup, meeting details, price, refund terms — all confirmed in writing within our support hours.</p></div>
        <div class="step"><h3>Pay after confirmation</h3><p>Remote support: ¥100 deposit to a verified merchant channel, ¥100 balance after your window. Experiences: deposit only once team and transport are locked.</p></div>
      </div>
      <p class="muted small" style="margin-top:1.5rem;">Every order is covered by the 30-minute guarantee and the no-shopping promise. <a href="/en/legal/refunds/">Refund policy →</a> · <a href="/en/legal/no-shopping/">No-shopping promise →</a></p>
    </div>
  </section>

  <CTASection primary heading="Not sure which fits? Tell us your dates and we'll suggest." />
</Base>

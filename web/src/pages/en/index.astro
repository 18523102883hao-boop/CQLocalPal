---
import Base from '../../layouts/Base.astro';
import TrustBar from '../../components/TrustBar.astro';
import ProductCard from '../../components/ProductCard.astro';
import CTASection from '../../components/CTASection.astro';
import HeroArt from '../../components/HeroArt.astro';
import { site } from '../../config';
import products from '../../data/products.json';

const concierge = products['concierge'];
const firstNight = products['first-night'];
const priv = products['private'];
const family = products['first-night-family'];
const nonSpicy = products['non-spicy-food-tour'];

const problems = [
  { title: 'Payments & apps', body: 'Card won\u2019t link, QR codes won\u2019t scan, an app screen you can\u2019t read — we walk you through each one, by message or a short call.' },
  { title: 'Getting connected', body: 'eSIM hiccups, hotel Wi-Fi that needs an SMS code, which map app actually works here. Sorted before it costs you an afternoon.' },
  { title: 'Routes & floors', body: 'Chongqing is a 3D maze: the "ground floor" on your map may be someone else\u2019s 11th. We decode the levels and the shortcuts.' },
  { title: 'Quick translation', body: 'Photograph a menu, a pharmacy label, a taxi driver\u2019s question — send it, we translate and tell you what to say back.' },
  { title: 'Ordering food', body: 'What to order, how spicy it really is, how to say 不要辣 (no chilli). We brief the kitchen directly when it matters.' },
  { title: 'Talking to businesses', body: 'Up to two short calls to restaurants, hotels or drivers per order — we speak Chinese so you don\u2019t have to pretend to.' },
];
---
<Base title="CQ Buddy — A real local, one message away" description="Remote local support for your first 72 hours in Chongqing: payments, apps, transport, translation and re-planning over WhatsApp. ¥200 per order, up to 4 travellers. No shopping stops, ever.">
  <section>
    <div class="container">
      <div class="hero-split">
        <div>
          <p class="eyebrow">Remote support · Chongqing, China</p>
          <h1>A real local,<br /><em>one message away.</em></h1>
          <p style="font-size:1.2rem;max-width:34ch;">Remote help for your first 72 hours in Chongqing. <strong>CNY 200 for a group of up to four</strong> — one chat for SIM, payments, transport and translation.</p>
          <p>
            <a class="btn btn-primary" href="/en/tours/concierge/">Get local support</a>
            &nbsp;
            <a class="btn btn-secondary" href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hi CQ Buddy! I have a question about the ¥200 local support.')}`} rel="noopener">Ask on WhatsApp</a>
          </p>
          <p class="muted small">No airport pickup or in-person guiding included — remote support only. ¥100 deposit after we confirm scope; balance after your window.</p>
        </div>
        <HeroArt />
      </div>
    </div>
  </section>

  <section class="white" style="padding-top:1rem;">
    <div class="container">
      <TrustBar />
    </div>
  </section>

  <section>
    <div class="container">
      <p class="eyebrow">What the ¥200 covers</p>
      <h2>Six problems we solve every week.</h2>
      <div class="grid">
        {problems.map((p) => (
          <div class="card"><h3>{p.title}</h3><p>{p.body}</p></div>
        ))}
      </div>
      <p class="muted small" style="margin-top:1.25rem;">Limits, honestly: we don\u2019t pay on your behalf, don\u2019t provide continuous interpretation, and medical or legal issues go to professionals — we help you communicate with them.</p>
    </div>
  </section>

  <section class="white">
    <div class="container">
      <p class="eyebrow">How it works</p>
      <h2>Four steps. One WhatsApp chat.</h2>
      <div class="steps">
        <div class="step"><h3>Tell us your dates</h3><p>Message or the booking form. We check capacity — max three overlapping trip windows at any time.</p></div>
        <div class="step"><h3>Meet your local contact</h3><p>A named local with real English. You get a free 20-minute planning call before you fly.</p></div>
        <div class="step"><h3>Confirm scope &amp; deposit</h3><p>Everything in writing — window, price, refund terms — then a ¥100 deposit to a verified merchant channel.</p></div>
        <div class="step"><h3>Get support on your trip</h3><p>72 hours of WhatsApp cover, {site.supportHours}, {site.responsePromise.toLowerCase()}.</p></div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <p class="eyebrow">Who answers</p>
      <h2>A named person, not a call centre.</h2>
      <p>You'll know who's on your chat before you pay — a real local with a real name, backed by a backup when they rest. <a href="/en/hosts/">Meet the team →</a></p>
    </div>
  </section>

  <section class="white">
    <div class="container">
      <p class="eyebrow">All services</p>
      <h2>Start remote. Add the city later.</h2>
      <div class="grid">
        <ProductCard hero href={`/en/tours/${concierge.slug}/`} name={concierge.name} priceCny={concierge.priceCny} unit={concierge.priceUnit} meta={`${concierge.duration} · Remote · Main service`} pitch={concierge.shortPitch} status={concierge.status} ctaLabel={concierge.ctaLabel} />
        <ProductCard href={`/en/tours/${firstNight.slug}/`} name={firstNight.name} priceCny={firstNight.priceCny} unit={firstNight.priceUnit} meta={`${firstNight.duration} · ${firstNight.partySize} · Airport`} pitch={firstNight.shortPitch} status={firstNight.status} ctaLabel={firstNight.ctaLabel} />
        <ProductCard href={`/en/tours/${priv.slug}/`} name={priv.name} priceCny={priv.priceCny} unit={priv.priceUnit} meta={`${priv.duration} · Guide + driver`} pitch={priv.shortPitch} status={priv.status} ctaLabel={priv.ctaLabel} />
        <ProductCard href={`/en/tours/${family.slug}/`} name={family.name} priceCny={family.priceCny} unit={family.priceUnit} meta="Family pace · Kids 6+" pitch={family.shortPitch} status={family.status} ctaLabel={family.ctaLabel} />
        <ProductCard href={`/en/add-ons/${nonSpicy.slug}/`} name={nonSpicy.name} priceCny={nonSpicy.priceCny} unit={nonSpicy.priceUnit} meta="2 hours · 4 tastings included" pitch={nonSpicy.shortPitch} status={nonSpicy.status} ctaLabel={nonSpicy.ctaLabel} />
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <p class="eyebrow">Verified reviews</p>
      <h2>We're welcoming our first guests.</h2>
      <p>{`We're welcoming our first guests. Verified reviews follow completed services — every rating, kept forever, good or bad.`}</p>
      <p><a href="/en/reviews/">How verification works →</a></p>
    </div>
  </section>

  <section class="white">
    <div class="container">
      <p class="eyebrow">Free, verified by hand</p>
      <h2>Guides &amp; an offline travel kit.</h2>
      <div class="grid">
        <div class="card"><h3><a href="/en/guide/payments-and-money/">Paying in Chongqing as a Visitor</a></h3><p>What actually works: phone payments first, cards sometimes, cash almost never.</p></div>
        <div class="card"><h3><a href="/en/guide/sim-card-and-internet/">Getting Connected After You Land</a></h3><p>eSIM vs airport SIM vs roaming, and the firewall explained without jargon.</p></div>
        <div class="card"><h3><a href="/en/travel-kit/">Offline travel kit</a></h3><p>Save the five guides, phrase cards and our contact to your phone — readable on the plane, no internet needed.</p></div>
      </div>
      <p style="margin-top:1.5rem;"><a class="btn btn-secondary" href="/en/guide/">All guides →</a></p>
    </div>
  </section>

  <CTASection primary heading="Coming to Chongqing? Get a local in your corner." />
</Base>

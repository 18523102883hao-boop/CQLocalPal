---
// 山城层次插画：暖纸/墨绿/陶土配色，呼应 Riverlight Journal。
// 无版权风险（手绘 SVG），后续可替换为授权实拍图。
---
<figure class="hero-art">
  <svg viewBox="0 0 640 440" role="img" aria-label="Illustration of Chongqing's layered mountain city above the Yangtze river">
    <rect width="640" height="440" fill="#F6F3EC"/>
    <!-- sky glow -->
    <circle cx="470" cy="96" r="52" fill="#D8CEBD" opacity="0.55"/>
    <!-- far ridge -->
    <path d="M0 200 L90 150 L180 190 L280 132 L380 178 L470 138 L560 180 L640 150 L640 440 L0 440 Z" fill="#D8CEBD" opacity="0.5"/>
    <!-- mid buildings -->
    <g fill="#A64531" opacity="0.75">
      <rect x="70" y="196" width="34" height="120"/>
      <rect x="120" y="176" width="26" height="140"/>
      <rect x="420" y="186" width="30" height="130"/>
      <rect x="470" y="166" width="24" height="150"/>
    </g>
    <!-- near cliff buildings (ink) -->
    <g fill="#173C32">
      <rect x="180" y="210" width="40" height="150"/>
      <rect x="232" y="188" width="30" height="172"/>
      <rect x="274" y="222" width="46" height="138"/>
      <rect x="332" y="200" width="28" height="160"/>
      <rect x="520" y="206" width="36" height="154"/>
      <rect x="566" y="186" width="26" height="174"/>
    </g>
    <!-- lit windows -->
    <g fill="#F6F3EC" opacity="0.85">
      <rect x="188" y="222" width="6" height="6"/><rect x="202" y="238" width="6" height="6"/><rect x="188" y="262" width="6" height="6"/>
      <rect x="240" y="200" width="6" height="6"/><rect x="250" y="222" width="6" height="6"/><rect x="240" y="248" width="6" height="6"/>
      <rect x="284" y="234" width="6" height="6"/><rect x="300" y="252" width="6" height="6"/><rect x="284" y="278" width="6" height="6"/>
      <rect x="340" y="212" width="6" height="6"/><rect x="340" y="240" width="6" height="6"/>
      <rect x="528" y="218" width="6" height="6"/><rect x="540" y="240" width="6" height="6"/>
      <rect x="572" y="200" width="6" height="6"/><rect x="572" y="228" width="6" height="6"/>
    </g>
    <!-- monorail line through buildings -->
    <path d="M0 300 L640 268" stroke="#202622" stroke-width="6"/>
    <rect x="288" y="252" width="72" height="26" rx="8" fill="#A64531"/>
    <rect x="296" y="258" width="14" height="10" fill="#F6F3EC"/>
    <rect x="318" y="258" width="14" height="10" fill="#F6F3EC"/>
    <!-- river -->
    <path d="M0 360 Q160 344 320 360 T640 356 L640 440 L0 440 Z" fill="#173C32" opacity="0.9"/>
    <path d="M0 384 Q160 372 320 384 T640 380" stroke="#F6F3EC" stroke-width="2.5" fill="none" opacity="0.5"/>
    <path d="M0 406 Q160 396 320 406 T640 402" stroke="#D8CEBD" stroke-width="2.5" fill="none" opacity="0.6"/>
    <!-- cableway -->
    <path d="M60 120 L560 92" stroke="#202622" stroke-width="1.5" opacity="0.6"/>
    <rect x="288" y="98" width="22" height="16" rx="3" fill="#202622"/>
    <path d="M299 98 L299 82" stroke="#202622" stroke-width="1.5"/>
  </svg>
  <figcaption class="hero-caption">The mountain city, layer by layer — most visitors see it for the first time at night, from ground level, with a dead phone. That's the moment we exist for.</figcaption>
</figure>

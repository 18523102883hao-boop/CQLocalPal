---
import { site } from '../config';
interface Props {
  sku?: string;
  heading?: string;
  primary?: boolean;
}
const { sku = 'Local Concierge', heading = 'Still deciding? Ask a real local.', primary = false } = Astro.props;
const text = encodeURIComponent(`Hi CQLocalPal! I'm interested in: ${sku}. My trip dates are around: `);
---
<section class="sand">
  <div class="container" style="text-align:center;">
    <h2>{heading}</h2>
    <p class="muted">{site.responsePromise} · {site.supportHours}</p>
    <p>
      {primary
        ? <a class="btn btn-primary" href="/en/booking/?product=concierge">Request local support</a>
        : <a class="btn btn-primary" href={`https://wa.me/${site.whatsapp}?text=${text}`} rel="noopener">Chat on WhatsApp</a>}
      &nbsp;
      <a class="btn btn-secondary" href="/en/booking/">Start a booking</a>
    </p>
  </div>
</section>

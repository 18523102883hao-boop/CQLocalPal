---
const items = [
  { icon: 'M20 6L9 17l-5-5', text: 'No shopping stops. Ever.' },
  { icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z', text: 'Cancel before we start, for a full refund.' },
  { icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z', text: 'Not happy in the first 30 minutes? A full refund.' },
  { icon: 'M8 12h8m-8 4h5M21 12a9 9 0 01-5.5 8.3L15 21l-1 2-1.5-1.5L11 23l-1-2-0.5-0.7A9 9 0 1121 12z', text: 'A real reply within 30 minutes, 08:00–24:00 Beijing time.' },
];
---
<div class="trustbar" role="list">
  {items.map((i) => (
    <span role="listitem">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#173C32" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={i.icon} /></svg>
      {i.text}
    </span>
  ))}
</div>

---
import { site, nav } from '../config';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  pageType?: string;
}
const { title, description, pageType = 'page' } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, site.url).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/icon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/icon-180.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#173C32" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="CQ Buddy" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <!-- 字体已自托管（OFL 许可），离线页不依赖外部请求 -->
  <link rel="stylesheet" href="/fonts/fonts.css" />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: site.url,
    description,
    areaServed: 'Chongqing, China',
    email: site.supportEmail,
  })} />
</head>
<body data-page-type={pageType}>
  <a href="#main" class="skip-link">Skip to content</a>
  <header class="site">
    <div class="container">
      <a class="logo" href="/en/">{site.name}</a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav">Menu</button>
      <nav class="main" id="main-nav" aria-label="Main">
        <ul>
          {nav.map((item) => (
            <li><a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <a class="btn btn-primary header-cta" href="/en/tours/concierge/">Get local support</a>
    </div>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer class="site">
    <div class="container">
      <div class="cols">
        <div>
          <h3>{site.name}</h3>
          <p class="small brand-tagline">{site.tagline}</p>
          <p class="small brand-hours">{site.responsePromise}, <span class="nowrap">{site.supportHours}</span>.</p>
        </div>
        <div>
          <h3>Services</h3>
          <ul>
            <li><a href="/en/tours/concierge/">Local Concierge · ¥200</a></li>
            <li><a href="/en/tours/first-night-chongqing/">First Night · ¥399</a></li>
            <li><a href="/en/tours/private/">Private Day · ¥1,600</a></li>
            <li><a href="/en/add-ons/non-spicy-food-tour/">Non-Spicy Food Walk · ¥259</a></li>
            <li><a href="/en/travel-kit/">Offline travel kit</a></li>
          </ul>
        </div>
        <div>
          <h3>Trust</h3>
          <ul>
            <li><a href="/en/legal/no-shopping/">No-shopping promise</a></li>
            <li><a href="/en/legal/refunds/">Refunds &amp; 30-minute guarantee</a></li>
            <li><a href="/en/reviews/">Verified reviews</a></li>
            <li><a href="/en/legal/terms/">Terms</a> · <a href="/en/legal/privacy/">Privacy</a> · <a href="/en/legal/cookies/">Cookies</a></li>
            <li><a href="/en/legal/reviews-policy/">Reviews policy</a></li>
          </ul>
        </div>
        <div>
          <h3>Talk to a local</h3>
          <ul>
            <li><a href={`https://wa.me/${site.whatsapp}`} rel="noopener">WhatsApp</a></li>
            <li><a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a></li>
            <li><a href="/en/contact/">Contact &amp; backup channels</a></li>
            <li><a href="/en/faq/">FAQ</a></li>
          </ul>
        </div>
      </div>
      <p class="legal-line">© 2026 {site.name} · Chongqing, China. Prices in CNY; USD/EUR shown as indicative reference only.</p>
    </div>
  </footer>
  <div class="cta-bar" role="complementary" aria-label="Quick actions">
    <a class="btn btn-primary" href="/en/tours/concierge/">Get local support</a>
    <a class="btn btn-secondary" href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hi CQ Buddy!')}`} rel="noopener">WhatsApp</a>
  </div>
  <script>
    const toggle = document.querySelector('.menu-toggle');
    const navEl = document.getElementById('main-nav');
    toggle?.addEventListener('click', () => {
      const open = navEl?.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(!!open));
    });
  </script>
</body>
</html>
